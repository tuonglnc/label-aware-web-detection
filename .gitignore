# Python / môi trường
__pycache__/
.venv/

# Key API: chỉ đẩy file mẫu env.example (key để trống)
.env
.env.*
!.env.example

# Dữ liệu SR-BH 2020 (tải và tạo lại bằng src/preprocessing, xem reports/dataset/huong_dan_xu_ly_du_lieu.md)
src/data/raw/
src/data/processed/

# File dữ liệu lớn hoặc có payload tấn công thô, sinh lại được
src/artifacts/data/manual_review.jsonl
src/artifacts/data/group_review.jsonl
src/artifacts/data/quarantine.jsonl
src/artifacts/data/*/manual_review.jsonl
src/artifacts/data/*/group_review.jsonl
src/artifacts/data/*/quarantine.jsonl
src/artifacts/data/reproduce/
